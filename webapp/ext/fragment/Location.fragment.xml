<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<VBox id="locationSection" width="100%" renderType="Bare">
		<Text id="locationAddress" text="{addressLine}" class="sapUiSmallMarginBottom"/>
		<Link id="locationLink" text="{i18n>openMap}" target="_blank"/>
		<core:HTML
			id="locationMap"
			preferDOM="true"
			sanitizeContent="false"
			content="&lt;div class=&quot;supplierLocationMap&quot;&gt;&lt;/div&gt;"/>
	</VBox>
</core:FragmentDefinition>
