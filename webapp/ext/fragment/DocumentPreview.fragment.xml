<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<VBox id="documentPreviewSection" width="100%" renderType="Bare"
		core:require="{ handler: 'mindtek/supplier/registration/ext/DocumentPreview' }">
		<Toolbar>
			<Title id="previewTitle" text="" level="H5"/>
			<ToolbarSpacer/>
			<Button
				id="downloadButton"
				text="{i18n>download}"
				icon="sap-icon://download"
				type="Emphasized"
				enabled="false"
				press="handler.onDownload"/>
		</Toolbar>
		<IllustratedMessage
			id="previewEmpty"
			illustrationType="sapIllus-NoData"
			title="{i18n>previewEmptyTitle}"
			description="{i18n>previewEmptyDescription}"/>
		<VBox id="previewHost" width="100%" visible="false" renderType="Bare"/>
	</VBox>
</core:FragmentDefinition>
